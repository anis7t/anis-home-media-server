# Secrets
.env
Caddyfile
secrets/

# Python
venv/
__pycache__/
*.pyc
.pytest_cache/

# Database
media.db
*.db
# SQLite WAL sidecars. `*.db` does not match these: WAL and shared-memory files
# are named after the database with a suffix, and they appear the moment any
# connection opens the DB in WAL mode - including on a live host, constantly.
media.db-shm
media.db-wal
*.db-shm
*.db-wal

# Cached/generated files
cache/
backups/

# Hermes kanban task worktrees (one per dispatched task)
.worktrees/

# Local backups / old versions
app.py.backup
app.py.phase2

# OS/editor files
.DS_Store
*.log
.agents/
skills-lock.json
bin/
logs/

# Agent workspaces and tooling metadata
.kilo/
.freebuff/

# External standalone sub-repos
Hermes-agent-android-PC-companion-app/

# Scratch notes
IDEA.md
_shots/

# Android Signing Secrets
*.jks
*.keystore
key.properties

# App Updates APK storage (version_registry.json is tracked)
updates/*
!updates/version_registry.json
!updates/.gitkeep

# OpenCode: read-only SQLite snapshot for the media-db MCP server (refresh via .opencode/db/refresh-snapshot.ps1)
.opencode/db/*.db
opencode/db/*.db.tmp

# Serena MCP local project state (semantic index; regenerate with the serena MCP)
.serena/

# Rust toolchain (cargo build artifacts)
target/
rust/target/
**/*.rs.bk

# Node / React toolchain
node_modules/
.next/
dist/
*.tsbuildinfo

# Local dev PostgreSQL never lives in the repo, but guard anyway:
# the portable cluster is E:\pgdata and the server binaries are E:\postgres\pgsql.
pgdata/
.pgpass

# Test artifacts
tests/screenshots/

