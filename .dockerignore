# Treat the repository as opt-in build context. This prevents local databases,
# media, credentials, generated artifacts, and unrelated project files from
# being sent to the Docker builder.
**

!Dockerfile
!.dockerignore
!rust
!rust/**
!web
!web/**

# Rust and React build outputs are always generated inside the build stages.
rust/target/
rust/**/target/
web/node_modules/
web/dist/
web/e2e/
web/test-results/
web/playwright-report/
